  "core" {>= "0.17.1"}
  "yojson" {>= "1.7.0"}
  "dream" {>= "1.0.0"}
  "dune" {>= "3.16" & >= "3.16"}
  "ppx_deriving" {>= "5.2.1"}
  "ppx_deriving_yojson" {>= "3.7.0"}
  "lwt" {>= "5.4.0"}
  "ppx_jane" {>= "v0.16.0"}
  "bisect_ppx" {>= "2.8.3"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
